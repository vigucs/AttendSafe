{
    "appId": "com.attend.safe",
    "productName": "AttendSafe",
    "directories": {
        "output": "release",
        "buildResources": "build"
    },
    "files": [
        "dist/**/*",
        "dist-electron/**/*",
        "package.json"
    ],
    "publish": {
        "provider": "github",
        "owner": "vigucs",
        "repo": "AttendSafe"
    },
    "win": {
        "target": "nsis",
        "icon": "build/icon.ico",
        "artifactName": "AttendSafe-Windows-Installer.exe"
    },
    "mac": {
        "target": [
            "dmg",
            "zip"
        ],
        "icon": "build/icon.icns",
        "category": "public.app-category.education",
        "artifactName": "AttendSafe-macOS.${ext}"
    },
    "dmg": {
        "artifactName": "AttendSafe-macOS.dmg"
    },
    "nsis": {
        "oneClick": true,
        "allowToChangeInstallationDirectory": false,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "AttendSafe"
    }
}
